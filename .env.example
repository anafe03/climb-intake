# Copy to .env. Without an API key the service runs in rules-only mode.
# Either key works. With both, LLM_PROVIDER=auto prefers Anthropic.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto | anthropic | openai
LLM_PROVIDER=auto
# auto | llm | rules   (auto = llm when a key is present, else rules)
CLASSIFIER_MODE=auto
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5
# Per-attempt deadline and retry count. Worst case per ticket is roughly
# LLM_TIMEOUT_S * (LLM_MAX_RETRIES + 1); anything slower degrades to keyword rules.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
# Connection errors fail fast, so they get their own budget separate from the deadline above.
LLM_CONNECTION_RETRIES=3
AUDIT_DB_PATH=./data/audit.db
